{
  agents: {
    defaults: {
      skills: [
        "sdd",
        "github-pr",
        "pr-review",
        "csharp-dotnet",
        "tailwind-4",
        "typescript",
        "skill-creator"
      ],
      model: {
        primary: "minimax/MiniMax-M2.7",
        fallbacks: ["anthropic/claude-opus-4-6"]
      },
      thinkingDefault: "medium",
      elevatedDefault: "on"
    }
  },
  mcp: {
    servers: {
      engram: {
        command: "~/.local/bin/engram",
        args: [],
        env: {
          ENGRAM_HOME: "~/.local/share/engram"
        }
      }
    }
  }
}
